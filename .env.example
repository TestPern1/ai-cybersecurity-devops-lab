# Copy this file to .env and adjust values. .env is git-ignored — never commit it.
# All values below are dummy placeholders; none of them are real credentials.

# --- Local LLM backend (LM Studio) ---
# LM Studio's OpenAI-compatible server does not require a real key; this placeholder
# is only present because the OpenAI SDK requires a non-empty string.
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=qwen2.5-7b-instruct

# --- Open-WebUI ---
OPEN_WEBUI_PORT=3000
OPEN_WEBUI_SECRET_KEY=change-me-to-a-random-local-only-string

# --- Loki / Promtail ---
LOKI_PORT=3100

# --- Web dashboard ---
WEB_DASHBOARD_PORT=4321

# --- Vulnerability agent ---
TRIVY_SEVERITY=CRITICAL,HIGH
