# Copy this file to .env and adjust values. .env is git-ignored — never commit it.
# All values below are dummy placeholders; none of them are real credentials.

# --- Local LLM backend (LM Studio) ---
# LM Studio's OpenAI-compatible server does not require a real key; this placeholder
# is only present because the OpenAI SDK requires a non-empty string.
#
# Running the agents directly on the same machine as LM Studio (no VM)?
# Use: LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
#
# Running the agents inside the VirtualBox VM (see docs/INSTALL.md)? LM Studio
# runs on the Windows host, not inside the VM, so point at the VirtualBox
# host-only adapter's host-side IP instead (default vboxnet0 IP shown below —
# confirm yours with `ipconfig` on Windows under the Host-Only adapter).
LM_STUDIO_BASE_URL=http://192.168.56.1:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=qwen2.5-7b-instruct

# Same host-only adapter IP, used by docker-compose to remap host.docker.internal
# for the Open-WebUI container (only relevant for the VirtualBox VM setup).
HOST_LM_STUDIO_IP=192.168.56.1

# --- Open-WebUI ---
OPEN_WEBUI_PORT=3000
OPEN_WEBUI_SECRET_KEY=change-me-to-a-random-local-only-string

# --- Loki / Promtail ---
LOKI_PORT=3100

# --- Web dashboard ---
WEB_DASHBOARD_PORT=4321

# --- Vulnerability agent ---
TRIVY_SEVERITY=CRITICAL,HIGH
